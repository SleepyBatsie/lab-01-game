{
  "name": "space-game-monorepo",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "start": "npm start --workspace=server",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "lint": "eslint shared/src server/src client/src e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench:load": "node --experimental-strip-types server/src/loadTest.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.4.0"
  }
}
